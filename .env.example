# Copy this file to .env and fill it in. Never share .env.
# (Sloth Lobster sets it to owner-only permissions automatically.)
TELEGRAM_TOKEN=123456:ABC-your-token-from-BotFather
ALLOWED_USER_ID=123456789

# Models: try qwen3.5:4b against qwen2.5:3b and keep whichever feels better
MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text
CHAT_KEEP_ALIVE=5m

# Uncomment when a proxy app (Clash, V2RayNG...) is running, e.g. in China:
# PROXY=http://127.0.0.1:7890

# Sites like Wikipedia ask bots to identify a contact (email or URL):
# CONTACT=you@example.com

# Index leftover /save documents while the tablet charges.
DIGEST_ON_CHARGE=1

# Your Obsidian vault. The Elephant writes cards, source pages and maps into its "Lobster Inbox" folder.
# (Run termux-setup-storage once; ~/storage/shared is your tablet's internal storage.)
VAULT_DIR=/data/data/com.termux/files/home/storage/shared/Documents/Slothvault
# Working files (saved documents, nightly backups), kept apart from the knowledge base.
# Sync this folder to Drive with a second Autosync pair (upload only).
WORK_DIR=/data/data/com.termux/files/home/storage/shared/Documents/Lobster work
# The subject areas a card can be filed under (edit freely):
LOCI=politics, economics, world history, markets and trading, language and culture

# Optional: a folder on a USB-C SSD for week-old raw pages (skipped when unplugged)
# ARCHIVE_DIR=/storage/XXXX-XXXX/Android/data/com.termux/files/lobster-archive

# The app (off until WEB_BIND is set and you ran: python set_password.py)
# Doors, comma-separated:
#   local          = the app on this tablet (https://127.0.0.1:8787)
#   100.x.y.z      = your Tailscale address, for the phones from anywhere
#   wifi           = the tablet's Wi-Fi address, only on networks named in WEB_TRUSTED_WIFI
# Never 0.0.0.0, never a forwarded router port. Public and mobile-data addresses are refused.
# WEB_BIND=local, 100.101.102.103, wifi
# WEB_TRUSTED_WIFI=Galaxy S25 hotspot name, Home network name
# WEB_PORT=8787
# HTTPS with Sloth Lobster's own certificate (needs: pkg install openssl-tool). auto or off.
# WEB_TLS=auto
# Extra names the app may be opened by, e.g. a Tailscale name:
# WEB_HOSTS=lobster-tablet

# Speed (run `python bench.py` on the tablet to find the best values)
# MODEL=qwen2.5:3b            # deciding what you want + chat replies
# WRITER_MODEL=               # research plans and briefs; empty = same as MODEL
# Deep research (/deep) runs overnight with a bigger writer: ollama pull qwen2.5:7b (about 4.7 GB)
# DEEP_WRITER_MODEL=qwen2.5:7b
# DEEP_HOURS=23-6              # local hours when OK'd deep jobs run (and only while charging, if that can be read)
# DEEP_MAX_MINUTES=60          # collecting stops here; the brief is still written
# MODEL_THREADS=0             # 0 = Ollama decides; often 4 (the fast cores) is quickest
# MODEL_THINK=                # "off" for Qwen3 models: much faster replies
# CHAT_KEEP_ALIVE=24h         # keep the model loaded, so there's no cold start

# Offline Wikipedia: Kiwix .zim files (named like wikipedia_en_top_mini_2026-09.zim), read straight from disk
# KIWIX_DIR=/storage/emulated/0/Kiwix

# Weather on the app's start screen (optional): your city; only its name and rounded coordinates go to Open-Meteo
# Weather on the start screen: easiest set in the app (tap the weather line). These are only the starting values.
# WEATHER_PLACE=San Francisco
# WEATHER_UNITS=fahrenheit
